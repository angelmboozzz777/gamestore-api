# Copia este archivo como .env y ajusta tus datos
# Cadena de conexion de MongoDB Atlas (Connect -> Drivers). Lleva tu contrasena: no la subas a git.
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/
MONGODB_DB=gamestore
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
TOKEN_EXPIRE_MINUTES=1440
